{
  "name": "vittacore",
  "private": true,
  "version": "1.0.1-beta.1",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "org.vittacore.desktop.beta.1_0_1",
    "productName": "VittaCore Beta 1.0.1",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "VittaCore-Beta-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VittaCore Beta 1.0.1"
    }
  },
  "allowScripts": {
    "electron@45.2.1": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true
  }
}
